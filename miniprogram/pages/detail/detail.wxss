/* pages/detail/detail.wxss */
.detail-page {
  padding-bottom: 120rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.post-card {
  background-color: #fff;
  padding: 24rpx;
  margin: 20rpx;
  border-radius: 16rpx;
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background-color: #eee;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.time {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.post-content {
  font-size: 32rpx;
  color: #333;
  line-height: 1.7;
  margin-bottom: 20rpx;
  word-break: break-all;
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.post-image {
  width: 210rpx;
  height: 210rpx;
  border-radius: 10rpx;
  background-color: #f0f0f0;
}

.post-actions {
  display: flex;
  align-items: center;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.action {
  display: flex;
  align-items: center;
  margin-right: 50rpx;
  font-size: 26rpx;
  color: #999;
}

.action .icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 8rpx;
}

.action .active {
  color: #FF6B6B;
}

.comment-section {
  background-color: #fff;
  margin: 0 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.comment-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.no-comment {
  text-align: center;
  padding: 60rpx 0;
  color: #ccc;
  font-size: 26rpx;
}

.comment-item {
  display: flex;
  margin-bottom: 30rpx;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
  background-color: #eee;
}

.comment-body {
  flex: 1;
}

.comment-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.comment-nickname {
  font-size: 24rpx;
  color: #4A90D9;
  margin-right: 16rpx;
}

.comment-time {
  font-size: 20rpx;
  color: #ccc;
}

.comment-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  word-break: break-all;
}

.comment-input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background-color: #fff;
  padding: 16rpx 20rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eee;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.03);
}

.comment-input {
  flex: 1;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  height: 64rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  margin-right: 16rpx;
}

.send-btn {
  background-color: #4A90D9;
  color: #fff;
  font-size: 26rpx;
  border-radius: 32rpx;
}
