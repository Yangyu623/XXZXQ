<!-- pages/mine/mine.wxml -->
<view class=\"mine-page\">
  <!-- 未登录状态 -->
  <view wx:if=\"{{!isLogin}}\" class=\"login-card\">
    <image class=\"default-avatar\" src=\"/images/default-avatar.png\" mode=\"aspectFill\" />
    <button class=\"login-btn\" bindtap=\"onLogin\">微信一键登录</button>
    <text class=\"login-tip\">登录后可以发帖和互动</text>
  </view>

  <!-- 已登录状态 -->
  <view wx:else>
    <view class=\"user-card\">
      <image class=\"user-avatar\" src=\"{{userInfo.avatarUrl}}\" mode=\"aspectFill\" />
      <view class=\"user-name\">{{userInfo.nickName}}</view>
      <view class=\"switch-btn\" bindtap=\"switchAccount\">切换账号</view>
    </view>

    <view class=\"section\">
      <view class=\"section-title\">我的帖子</view>
      <view wx:if=\"{{myPosts.length === 0}}\" class=\"no-posts\">还没有发过帖子</view>
      <view wx:for=\"{{myPosts}}\" wx:key=\"_id\" class=\"post-item\" bindtap=\"goDetail\" data-id=\"{{item._id}}\">
        <view class=\"post-text\">{{item.content}}</view>
        <view class=\"post-meta\">
          <text class=\"post-time\">{{item.createTimeText || ''}}</text>
          <text class=\"delete-link\" catchtap=\"deletePost\" data-id=\"{{item._id}}\">删除</text>
        </view>
      </view>
    </view>
  </view>
</view>
