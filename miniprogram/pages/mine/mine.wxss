/* pages/mine/mine.wxss */
.mine-page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.login-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.default-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin-bottom: 40rpx;
  opacity: 0.6;
}

.login-btn {
  background-color: #07C160;
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  padding: 20rpx 60rpx;
  border: none;
}

.login-tip {
  margin-top: 30rpx;
  font-size: 24rpx;
  color: #999;
}

.user-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
  background: linear-gradient(135deg, #4A90D9, #7BB3E8);
  color: #fff;
}

.user-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.4);
  margin-bottom: 20rpx;
}

.user-name {
  font-size: 34rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.switch-btn {
  font-size: 24rpx;
  opacity: 0.8;
  padding: 8rpx 24rpx;
  border: 1rpx solid rgba(255,255,255,0.5);
  border-radius: 30rpx;
}

.section {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.no-posts {
  text-align: center;
  color: #ccc;
  font-size: 26rpx;
  padding: 40rpx 0;
}

.post-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.post-item:last-child {
  border-bottom: none;
}

.post-text {
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 10rpx;
}

.post-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #999;
}

.delete-link {
  color: #FF6B6B;
}
